{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-review-squad.local/schemas/review-report.v2.schema.json",
  "title": "Codex Review Squad Report 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "mode",
    "generated_at",
    "generator",
    "target",
    "review_context",
    "summary",
    "findings",
    "not_verified",
    "mode_data",
    "sources",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "report_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"},
    "mode": {"enum": ["experts", "normies", "regulars", "well-actually"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "skill"],
      "properties": {
        "name": {"const": "codex-review-squad"},
        "version": {"type": "string", "minLength": 1},
        "skill": {"enum": ["review-squad:experts", "review-squad:normies", "review-squad:regulars", "review-squad:well-actually"]}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "url", "name"],
      "properties": {
        "kind": {"enum": ["repository", "site", "application", "pull_request", "branch", "story", "unknown"]},
        "path": {"type": ["string", "null"]},
        "url": {"type": ["string", "null"], "format": "uri"},
        "name": {"type": ["string", "null"]}
      }
    },
    "review_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["labels", "branch", "base_branch", "pull_request", "story", "commit", "working_tree_dirty"],
      "properties": {
        "labels": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}, "uniqueItems": true},
        "branch": {"type": ["string", "null"]},
        "base_branch": {"type": ["string", "null"]},
        "pull_request": {"type": ["string", "integer", "null"]},
        "story": {"type": ["string", "null"]},
        "commit": {"type": ["string", "null"]},
        "working_tree_dirty": {"type": ["boolean", "null"]}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headline", "overall_status", "critical_count", "important_count", "minor_count", "not_verified_count", "recommended_next_move"],
      "properties": {
        "headline": {"type": "string", "minLength": 1},
        "overall_status": {"enum": ["pass", "needs_attention", "blocked", "mixed"]},
        "critical_count": {"type": "integer", "minimum": 0},
        "important_count": {"type": "integer", "minimum": 0},
        "minor_count": {"type": "integer", "minimum": 0},
        "not_verified_count": {"type": "integer", "minimum": 0},
        "recommended_next_move": {"type": "string", "minLength": 1}
      }
    },
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "not_verified": {"type": "array", "items": {"$ref": "#/$defs/not_verified"}},
    "mode_data": {
      "oneOf": [
        {"$ref": "#/$defs/experts_data"},
        {"$ref": "#/$defs/normies_data"},
        {"$ref": "#/$defs/regulars_data"},
        {"$ref": "#/$defs/well_actually_data"}
      ]
    },
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}, "uniqueItems": true},
    "artifacts": {"$ref": "#/$defs/artifacts"},
    "extensions": {"type": "object", "additionalProperties": true}
  },
  "allOf": [
    {"if": {"properties": {"mode": {"const": "experts"}}}, "then": {"properties": {"mode_data": {"$ref": "#/$defs/experts_data"}}}},
    {"if": {"properties": {"mode": {"const": "normies"}}}, "then": {"properties": {"mode_data": {"$ref": "#/$defs/normies_data"}}}},
    {"if": {"properties": {"mode": {"const": "regulars"}}}, "then": {"properties": {"mode_data": {"$ref": "#/$defs/regulars_data"}}}},
    {"if": {"properties": {"mode": {"const": "well-actually"}}}, "then": {"properties": {"mode_data": {"$ref": "#/$defs/well_actually_data"}}}}
  ],
  "$defs": {
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "stem", "json_path", "markdown_path"],
      "properties": {
        "status": {"enum": ["written", "inline_only"]},
        "stem": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "json_path": {"type": ["string", "null"]},
        "markdown_path": {"type": ["string", "null"]}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "written"}}}, "then": {"properties": {"json_path": {"type": "string", "minLength": 1}, "markdown_path": {"type": "string", "minLength": 1}}}},
        {"if": {"properties": {"status": {"const": "inline_only"}}}, "then": {"properties": {"json_path": {"type": "null"}, "markdown_path": {"type": "null"}}}}
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "title", "description", "evidence", "source", "suggested_fix"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "severity": {"enum": ["critical", "important", "minor"]},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "source": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "suggested_fix": {"type": "string", "minLength": 1},
        "impact": {"$ref": "#/$defs/impact"},
        "decision": {"$ref": "#/$defs/decision"},
        "affected_files": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "detail"],
      "properties": {
        "kind": {"enum": ["file", "url", "screenshot", "browser_observation", "command_output", "reviewer_observation"]},
        "detail": {"type": "string", "minLength": 1},
        "path": {"type": ["string", "null"]},
        "line": {"type": ["integer", "null"], "minimum": 1},
        "line_end": {"type": ["integer", "null"], "minimum": 1},
        "url": {"type": ["string", "null"], "format": "uri"}
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtime": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "delivery": {"type": "string", "minLength": 1}
      },
      "minProperties": 1
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "question", "consequence", "recommendation"],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "question": {"type": "string", "minLength": 1},
        "consequence": {"type": "string", "minLength": 1},
        "recommendation": {"type": "string", "minLength": 1}
      }
    },
    "not_verified": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item", "reason", "source"],
      "properties": {
        "item": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "source": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "type": {"enum": ["expert", "persona", "task", "current_agent", "tool"]}
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priority", "action"],
      "properties": {
        "priority": {"enum": ["critical", "important", "minor"]},
        "action": {"type": "string", "minLength": 1}
      }
    },
    "task_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "result", "detail"],
      "properties": {
        "task": {"type": "string", "minLength": 1},
        "result": {"enum": ["pass", "partial", "fail"]},
        "detail": {"type": "string", "minLength": 1}
      }
    },
    "persona_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["persona", "observations"],
      "properties": {
        "persona": {"type": "string", "minLength": 1},
        "observations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "confusion_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["persona", "point", "status", "detail"],
      "properties": {
        "persona": {"type": "string", "minLength": 1},
        "point": {"type": "string", "minLength": 1},
        "status": {"enum": ["clear", "confusing", "missing"]},
        "detail": {"type": "string", "minLength": 1}
      }
    },
    "fix_list_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effort", "action"],
      "properties": {
        "effort": {"enum": ["tiny", "small", "medium", "large"]},
        "action": {"type": "string", "minLength": 1},
        "finding_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "experts_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "panel"],
      "properties": {
        "type": {"const": "experts"},
        "panel": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "implementation_plan_offer": {"type": "boolean"}
      }
    },
    "normies_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "personas", "confusion_matrix", "recommendations", "what_worked"],
      "properties": {
        "type": {"const": "normies"},
        "panel_status": {"enum": ["complete", "partial", "not_run"]},
        "personas": {"type": "array", "items": {"$ref": "#/$defs/persona_output"}},
        "confusion_matrix": {"type": "array", "items": {"$ref": "#/$defs/confusion_entry"}},
        "recommendations": {"type": "array", "items": {"$ref": "#/$defs/recommendation"}},
        "what_worked": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "regulars_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "scorecard", "result_counts", "blockers", "friction", "what_worked"],
      "properties": {
        "type": {"const": "regulars"},
        "scorecard": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/task_result"}},
        "result_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pass", "partial", "fail"],
          "properties": {"pass": {"type": "integer", "minimum": 0}, "partial": {"type": "integer", "minimum": 0}, "fail": {"type": "integer", "minimum": 0}}
        },
        "blockers": {"type": "array", "items": {"$ref": "#/$defs/recommendation"}},
        "friction": {"type": "array", "items": {"$ref": "#/$defs/recommendation"}},
        "what_worked": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "well_actually_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "roast_by_persona", "cross_persona_consensus", "practical_fixlist"],
      "properties": {
        "type": {"const": "well-actually"},
        "roast_by_persona": {"type": "array", "items": {"$ref": "#/$defs/persona_output"}},
        "cross_persona_consensus": {"type": "array", "items": {"$ref": "#/$defs/recommendation"}},
        "practical_fixlist": {"type": "array", "items": {"$ref": "#/$defs/fix_list_entry"}}
      }
    }
  }
}
